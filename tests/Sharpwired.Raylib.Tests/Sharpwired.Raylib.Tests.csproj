    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Sharpwired.Raylib\Sharpwired.Raylib.csproj" />
    <ProjectReference Include="..\..\src\Sharpwired.Timing\Sharpwired.Timing.csproj" />
  </ItemGroup>

</Project>
