<Project Sdk="Microsoft.NET.Sdk">

  <!-- No Handwired source. The WebGPU backend. Only GpuDevice.cs and ComputeKernel.cs call the native
       API of the Silk.NET packages, and only these two files have unsafe code. -->

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sharpwired.Gpu.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sharpwired.Cells\Sharpwired.Cells.csproj" />
    <ProjectReference Include="..\Sharpwired.Core\Sharpwired.Core.csproj" />
    <ProjectReference Include="..\Sharpwired.IL\Sharpwired.IL.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Silk.NET.WebGPU" Version="2.23.0" />
    <PackageReference Include="Silk.NET.WebGPU.Native.WGPU" Version="2.23.0" />
    <PackageReference Include="Silk.NET.WebGPU.Extensions.WGPU" Version="2.23.0" />
  </ItemGroup>

</Project>
